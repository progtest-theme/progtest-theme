{
    "name": "progtest-theme",
    "version": "1.4.1",
    "description": "Theme manager for ProgTest",
    "main": "src/background.js",
    "scripts": {
        "build": "bun run scripts/run_build.ts",
        "build:firefox": "bun run build && bun run scripts/package.ts --firefox",
        "build:chrome": "bun run build && bun run scripts/package.ts --chrome",
        "dev": "bun run scripts/dev.ts",
        "lint": "stylelint \"src/**/*.css\" && eslint .",
        "lint:fix": "prettier --write . && stylelint \"src/**/*.css\" --fix && eslint . --fix",
        "version": "bun run scripts/version.ts"
    },
    "repository": { "type": "git", "url": "git+https://github.com/progtest-theme/progtest-theme.git" },
    "author": "keombre",
    "license": "MIT",
    "bugs": { "url": "https://github.com/progtest-theme/progtest-theme/issues" },
    "homepage": "https://github.com/progtest-theme/progtest-theme",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/archiver": "^8.0.0",
        "@types/bun": "^1.4.4",
        "@types/chrome": "^0.3.7",
        "@types/minimist": "^1.2.5",
        "@types/web": "^0.0.360",
        "advanced-extension-reloader-watch-2": "^3.1.0",
        "archiver": "^8.0.0",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.24.0",
        "globals": "^17.14.0",
        "minimist": "^1.2.8",
        "prettier": "^3.9.10",
        "prettier-plugin-svelte": "^4.1.1",
        "stylelint": "^18.0.0",
        "stylelint-config-standard": "^41.0.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.1",
        "web-ext": "^10.8.0"
    },
    "dependencies": {
        "classnames": "^2.5.1",
        "highlight.js": "^11.12.0",
        "iconify-icon": "^3.0.5",
        "normalize.css": "^8.0.1",
        "svelte": "^5.57.3"
    }
}
