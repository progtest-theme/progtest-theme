{
    "name": "progtest-theme",
    "version": "1.3.0",
    "description": "Theme manager for ProgTest",
    "main": "src/background.js",
    "scripts": {
        "build": "bun run scripts/run_build.ts",
        "build:firefox": "bun run build && bun run scripts/package.ts --firefox",
        "build:chrome": "bun run build && bun run scripts/package.ts --chrome",
        "dev": "bun run scripts/dev.ts",
        "lint": "stylelint **/*.css; eslint .",
        "lint:fix": "prettier --write .; stylelint **/*.css --fix; eslint . --fix",
        "version": "bun run scripts/version.ts"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/progtest-theme/progtest-theme.git"
    },
    "author": "keombre",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/progtest-theme/progtest-theme/issues"
    },
    "homepage": "https://github.com/progtest-theme/progtest-theme",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/archiver": "^7.0.0",
        "@types/bun": "^1.3.11",
        "@types/chrome": "^0.1.38",
        "@types/minimist": "^1.2.5",
        "@types/web": "^0.0.344",
        "advanced-extension-reloader-watch-2": "^2.1.0",
        "archiver": "^7.0.1",
        "eslint": "^10.1.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.16.0",
        "globals": "^17.4.0",
        "minimist": "^1.2.8",
        "prettier": "^3.8.1",
        "prettier-plugin-svelte": "^3.5.1",
        "stylelint": "^17.5.0",
        "stylelint-config-standard": "^40.0.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.57.1",
        "web-ext": "^10.0.0",
        "svelte-preprocess": "^6.0.3"
    },
    "dependencies": {
        "classnames": "^2.5.1",
        "highlight.js": "^11.11.1",
        "iconify-icon": "^3.0.2",
        "normalize.css": "^8.0.1",
        "svelte": "^4.2.20"
    }
}
